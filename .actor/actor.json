{
  "actorSpecification": 1,
  "name": "linkedin-url-to-sales-nav-url",
  "title": "LinkedIn URL to Sales Nav URL",
  "description": "Convert LinkedIn profile URLs to Sales Navigator URLs in bulk. Single or bulk input supported.",
  "version": "1.0",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn URL to Sales Nav URL Output",
    "description": "LinkedIn profiles with converted Sales Navigator URLs.",
    "properties": {
      "results": {
        "type": "string",
        "title": "Results",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "input_url",
              "normalized_url",
              "data_status",
              "profile_id",
              "full_name",
              "first_name",
              "last_name",
              "headline",
              "location",
              "country_code",
              "sales_nav_url",
              "profile_url",
              "current_company",
              "current_title",
              "industry",
              "profile_picture",
              "request_id",
              "order_id",
              "processed_at"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
